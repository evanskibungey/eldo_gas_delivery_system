# ─── Production build values (COMMITTED TO GIT) ──────────────────────────────
#
# Vite loads this on top of .env for `npm run build`, so these are the values
# compiled into the JS bundle that ships to real browsers.
#
# ONLY VITE_* keys belong here. Everything in this file ends up readable inside
# public/build/assets/*.js, so it is public by definition. Secrets go in the
# Forge environment editor, never here — scripts/check-build-env.mjs fails the
# build if a non-VITE_ key appears.
#
# Change these and you must re-run `npm run build` and commit the result, or
# production keeps serving the previous bundle.

VITE_APP_NAME="EldoGas"

VITE_REVERB_APP_KEY=eda691e3e06940517fac2aa2ffa09ee0
VITE_REVERB_HOST=eldogas.ke
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
